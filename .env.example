# =============================================================
# ByteCommerce - Template Environment Variables
# Salin file ini menjadi .env (di root project atau backend/.env)
# dan sesuaikan nilainya dengan environment masing-masing.
# JANGAN pernah meng-commit file .env ke repository.
# =============================================================

# Port yang digunakan oleh backend API Express
PORT=5000

# URL koneksi PostgreSQL 16 (driver native pg).
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Gunakan localhost:5432 untuk development lokal,
# atau host service postgres_db di dalam Docker network.
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/bytecommerce_db

# URL koneksi Redis 7 (driver ioredis).
# Format: redis://<host>:<port>
# Gunakan localhost:6379 untuk development lokal,
# atau host service redis_cache di dalam Docker network.
REDIS_URL=redis://localhost:6379

# Secret key untuk signing dan verifikasi JWT.
# WAJIB diganti dengan nilai acak yang panjang di production.
JWT_SECRET=bytecommerce_jwt_dev_secret_2026

# Environment runtime: development | production | test
NODE_ENV=development
